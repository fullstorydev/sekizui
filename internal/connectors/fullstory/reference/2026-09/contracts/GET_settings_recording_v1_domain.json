{
  "tier": "v1",
  "method": "GET",
  "path": "/settings/recording/v1/domain",
  "operation_id": "GetDomainSettings",
  "title": "Get Domain Settings",
  "description": "Returns the current domain settings for recording.",
  "permission": "Standard",
  "servers": [
    "https://api.fullstory.com"
  ],
  "docs": "https://developer.fullstory.com/server/v1/settings/get-domain-settings/",
  "parameters": [
    {
      "name": "platform",
      "description": "Determines which platform to show settings from - `web` or `mobile`. Defaults to `web`.",
      "in": "query",
      "required": false,
      "schema": {
        "type": "string"
      }
    }
  ],
  "response": {
    "type": "object",
    "example": {
      "onlyRecordKnownDomains": false,
      "domains": [
        {
          "disabled": false,
          "domain": "fullstory.com"
        }
      ],
      "metadata": {
        "lastUpdated": "2020-10-01T23:53:05.821Z",
        "lastUpdatedBy": "bob@example.com",
        "created": "2020-10-01T23:53:05.821Z",
        "createdBy": "bob@example.com"
      }
    },
    "properties": {
      "onlyRecordKnownDomains": {
        "type": "boolean"
      },
      "domains": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "disabled": {
              "type": "boolean"
            },
            "domain": {
              "type": "string"
            }
          }
        }
      },
      "metadata": {
        "type": "object",
        "properties": {
          "lastUpdated": {
            "type": "string",
            "format": "date-time",
            "description": "When this entity was last updated."
          },
          "lastUpdatedBy": {
            "type": "string",
            "description": "Who made the last update to this entity."
          },
          "created": {
            "type": "string",
            "format": "date-time",
            "description": "When this entity was first created."
          },
          "createdBy": {
            "type": "string",
            "description": "Who first created this entity."
          }
        },
        "title": "This is a public-facing semi-duplicate of protoauditstore.AuditMetadata"
      }
    }
  }
}
