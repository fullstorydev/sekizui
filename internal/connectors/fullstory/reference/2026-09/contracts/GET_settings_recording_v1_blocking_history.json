{
  "tier": "v1",
  "method": "GET",
  "path": "/settings/recording/v1/blocking/history",
  "operation_id": "GetRecordingBlockRulesHistory",
  "title": "Get Block Rules History",
  "description": "Returns a list of versions, each denoting a set of the Block Rules Settings. Every time these settings are modified, a new version is created. This endpoint allows for paging through the history of these settings for audit purposes.",
  "permission": "Standard",
  "servers": [
    "https://api.fullstory.com"
  ],
  "docs": "https://developer.fullstory.com/server/v1/settings/get-recording-block-rules-history/",
  "parameters": [
    {
      "name": "paginationToken",
      "description": "The token to start the page at. The default is the most recent version of settings.",
      "in": "query",
      "required": false,
      "schema": {
        "type": "string"
      }
    },
    {
      "name": "limit",
      "description": "The max number of returned versions. The default is 20 and the max is 100.",
      "in": "query",
      "required": false,
      "schema": {
        "type": "integer",
        "format": "int32"
      }
    }
  ],
  "response": {
    "type": "object",
    "example": {
      "versions": [
        {
          "blockedIps": [
            "55.55.55.55",
            "99.99.99.*"
          ],
          "blockedUas": [
            "YandexBot",
            "facebot"
          ],
          "blockedAppIds": [],
          "metadata": {
            "lastUpdated": "2020-10-23T15:05:50.778Z",
