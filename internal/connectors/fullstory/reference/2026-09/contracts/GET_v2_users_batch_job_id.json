{
  "tier": "v2",
  "method": "GET",
  "path": "/v2/users/batch/{job_id}",
  "operation_id": "GetBatchUserImportStatus",
  "title": "Get Batch Import Job Details",
  "description": "Get the status for a batch user import job with job details.",
  "permission": "Standard",
  "servers": [
    "https://api.fullstory.com"
  ],
  "docs": "https://developer.fullstory.com/server/users/get-batch-user-import-status/",
  "parameters": [
    {
      "name": "job_id",
      "description": "ID that can be used to check the status and retrieve results for the batch import",
      "in": "path",
      "required": true,
      "schema": {
        "type": "string"
      }
    }
  ],
  "response": {
    "type": "object",
    "properties": {
      "imports": {
        "type": "integer",
        "format": "int32",
        "example": 42,
        "description": "The stats on the number of items imported successfully"
      },
      "errors": {
        "type": "integer",
        "format": "int32",
        "example": 2,
        "description": "Only included for failed imports. The stats on the number of items that failed to be imported"
      },
      "job": {
        "example": {
          "id": "abd123=",
          "status": "FAILED",
          "created": "2019-04-18T14:36:11.123Z",
          "finished": "2019-04-18T15:36:11.123Z"
        },
        "description": "Information about the current state of the job",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "abc123",
            "description": "ID of the job."
          },
          "status": {
            "example": "PROCESSING",
            "description": "Status of the job.",
            "type": "string",
            "enum": [
              "PROCESSING",
              "COMPLETED",
              "FAILED"
            ],
            "default": "UNKNOWN"
          },
          "created": {
            "type": "string",
            "format": "date-time",
            "example": "2017-01-15T01:30:15.01Z",
            "description": "Time the job was accepted."
          },
          "finished": {
            "type": "string",
            "format": "date-time",
            "description": "Time the job was finished, either successfully or unsuccessfully.",
            "x-fullstory-doc-example-ignore": true
          }
        },
        "title": "JobMetadata",
        "required": [
          "id",
          "status",
          "created"
        ]
      }
    },
    "description": "Server response for the job status",
    "required": [
      "imports",
      "errors",
      "job"
    ],
    "example": {
      "imports": 42,
      "errors": 2,
      "job": {
        "id": "abd123=",
        "status": "FAILED",
        "created": "2019-04-18T14:36:11.123Z",
        "finished": "2019-04-18T15:36:11.123Z"
      }
    }
  }
}
