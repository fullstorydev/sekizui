{
  "tier": "v1",
  "method": "GET",
  "path": "/settings/recording/v1/features/history",
  "operation_id": "GetRecordingFeaturesHistory",
  "title": "Get Recording Features History",
  "description": "Returns a list of versions, each denoting a set of the Recording Features Settings. Every time these settings are modified, a new version is created. This endpoint allows for paging through the history of these settings for audit purposes.",
  "permission": "Standard",
  "servers": [
    "https://api.fullstory.com"
  ],
  "docs": "https://developer.fullstory.com/server/v1/settings/get-recording-features-history/",
  "parameters": [
    {
      "name": "paginationToken",
      "description": "The token to start the page at. The default is the most recent version of settings.",
      "in": "query",
      "required": false,
      "schema": {
        "type": "string"
      }
    },
    {
      "name": "limit",
      "description": "The max number of returned versions. The default is 20 and the max is 100.",
      "in": "query",
      "required": false,
      "schema": {
        "type": "integer",
        "format": "int32"
      }
    },
    {
      "name": "platform",
      "description": "Determines which platform to show settings from - `web` or `mobile`. Defaults to `web`.",
      "in": "query",
      "required": false,
      "schema": {
        "type": "string"
      }
    }
  ],
